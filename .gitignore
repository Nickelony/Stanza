# Build output
bin/
obj/
artifacts/
*.nupkg
*.snupkg

# Test results and logs
TestResults/
*.trx
*.binlog
*.log

# User-specific files
.vs/
*.user
*.suo
*.tmp

# VS Code keeps only the shared files.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Temp files the markup tool writes beside the file it rewrites; `*.tmp` does not match them.
*.stanza-tmp

# The maintainer's own notes and process, kept out of the repository.
AGENTS.md
BACKLOG.md
RELEASING.md
REVIEWING.md

# Local tool state.
.claude/
.codebase-memory/
.cursor/

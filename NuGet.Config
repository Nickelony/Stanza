<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<!-- Clears inherited sources so dependencies cannot resolve from an unselected feed. -->
	<packageSources>
		<clear />
		<add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
	</packageSources>

	<!-- NuGet queries only sources whose package pattern matches the ID; this wildcard includes every package. -->
	<packageSourceMapping>
		<packageSource key="nuget.org">
			<package pattern="*" />
		</packageSource>
	</packageSourceMapping>
</configuration>

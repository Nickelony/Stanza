<?xml version="1.0" encoding="utf-8"?>
<!-- The runner stops a test that outlasts TestTimeout, so a loop that never ends fails its own test and not the job. -->
<!-- Keep it above the slowest test, a convergence matrix that runs for minutes beside the rest of the suite. -->
<RunSettings>
	<MSTest>
		<TestTimeout>300000</TestTimeout>
	</MSTest>
</RunSettings>

{
	"name": "eslint-plugin-stanza",
	"version": "0.9.0",
	"private": true,
	"type": "module",
	"description": "ESLint rules that lay out the blank lines of JavaScript and TypeScript code, the sibling of the Stanza C# analyzers.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Nickelony/Stanza.git",
		"directory": "js"
	},
	"keywords": [
		"eslint",
		"eslintplugin",
		"eslint-plugin",
		"formatting",
		"blank lines"
	],
	"engines": {
		"node": "^22.18.0 || ^24.0.0 || >=26.0.0"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc --project tsconfig.build.json",
		"typecheck": "tsc --noEmit",
		"test": "node --test \"test/**/*.test.ts\"",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint src test"
	},
	"peerDependencies": {
		"eslint": "^9.0.0 || ^10.0.0"
	},
	"devDependencies": {
		"@ianvs/prettier-plugin-sort-imports": "^4.7.1",
		"@types/node": "^24.19.2",
		"@typescript-eslint/utils": "^8.72.1",
		"eslint": "^9.39.0",
		"prettier": "^3.9.10",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.72.1"
	}
}

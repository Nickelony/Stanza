{
	"printWidth": 150,
	"useTabs": true,
	"singleQuote": true,
	"trailingComma": "all",
	"endOfLine": "lf",
	"plugins": ["@ianvs/prettier-plugin-sort-imports"],
	"importOrderParserPlugins": ["typescript", "jsx", "decorators-legacy"],
	"importOrder": [
		"<BUILTIN_MODULES>",
		"",
		"<THIRD_PARTY_MODULES>",
		"",
		"^[.][.]/",
		"",
		"^[.]/[^/]+[.]ts$",
		"",
		"^[.]/[^/]+/",
		"",
		"^[.]/.+[.](png|css)$"
	]
}

root = true

[*.cs]

# A pin is a `dotnet_diagnostic.<ID>.severity` line. FormatterSettingsGuardTests requires a ZA pin in this section for each rule,
# with `none` exactly for its `disabled` array, and the `[tests/**/*.cs]` pins match its `offInTests` array.
# A `none` rule ships off and stays off: it is the half of a pair whose other half is on, or a rule that asks for a shape the tree does not write.
# A rule added or disabled changes its pin and those arrays together.

# Blank lines between units.
dotnet_diagnostic.ZA0001.severity = warning
dotnet_diagnostic.ZA0002.severity = warning
dotnet_diagnostic.ZA0004.severity = warning
dotnet_diagnostic.ZA0005.severity = warning
dotnet_diagnostic.ZA0006.severity = warning
dotnet_diagnostic.ZA0007.severity = warning
dotnet_diagnostic.ZA0008.severity = warning
dotnet_diagnostic.ZA0009.severity = warning

# Blank lines inside delimited lists.
dotnet_diagnostic.ZA0010.severity = none
dotnet_diagnostic.ZA0011.severity = warning
dotnet_diagnostic.ZA0012.severity = warning
dotnet_diagnostic.ZA0013.severity = warning
dotnet_diagnostic.ZA0014.severity = none
dotnet_diagnostic.ZA0015.severity = warning
dotnet_diagnostic.ZA0016.severity = warning
dotnet_diagnostic.ZA0017.severity = none
dotnet_diagnostic.ZA0018.severity = warning
dotnet_diagnostic.ZA0019.severity = warning
dotnet_diagnostic.ZA0020.severity = none
dotnet_diagnostic.ZA0021.severity = warning
dotnet_diagnostic.ZA0022.severity = warning
dotnet_diagnostic.ZA0023.severity = none
dotnet_diagnostic.ZA0024.severity = warning
dotnet_diagnostic.ZA0025.severity = warning
dotnet_diagnostic.ZA0026.severity = none
dotnet_diagnostic.ZA0027.severity = warning
dotnet_diagnostic.ZA0028.severity = warning
dotnet_diagnostic.ZA0029.severity = none
dotnet_diagnostic.ZA0030.severity = warning
dotnet_diagnostic.ZA0031.severity = warning
dotnet_diagnostic.ZA0032.severity = none
dotnet_diagnostic.ZA0033.severity = warning

# Clauses and braces.
dotnet_diagnostic.ZA0034.severity = none
dotnet_diagnostic.ZA0035.severity = warning
dotnet_diagnostic.ZA0036.severity = warning
dotnet_diagnostic.ZA0037.severity = warning
dotnet_diagnostic.ZA0038.severity = warning
dotnet_diagnostic.ZA0039.severity = warning

# Member bodies.
dotnet_diagnostic.ZA0040.severity = warning
dotnet_diagnostic.ZA0041.severity = warning
dotnet_diagnostic.ZA0042.severity = none
dotnet_diagnostic.ZA0043.severity = warning
dotnet_diagnostic.ZA0044.severity = warning
dotnet_diagnostic.ZA0045.severity = warning
dotnet_diagnostic.ZA0046.severity = none

# Regions.
dotnet_diagnostic.ZA0047.severity = warning
dotnet_diagnostic.ZA0048.severity = warning
dotnet_diagnostic.ZA0049.severity = warning

# Argument names.
dotnet_diagnostic.ZA0050.severity = warning
dotnet_diagnostic.ZA0051.severity = warning

# Markup in raw strings.
dotnet_diagnostic.ZA0101.severity = warning
dotnet_diagnostic.ZA0102.severity = none
dotnet_diagnostic.ZA0103.severity = warning
dotnet_diagnostic.ZA0104.severity = warning
dotnet_diagnostic.ZA0105.severity = warning

# Documentation comments.
dotnet_diagnostic.ZA0201.severity = warning
dotnet_diagnostic.ZA0202.severity = warning
dotnet_diagnostic.ZA0203.severity = warning
dotnet_diagnostic.ZA0204.severity = warning
dotnet_diagnostic.ZA0205.severity = warning
dotnet_diagnostic.ZA0206.severity = warning
dotnet_diagnostic.ZA0207.severity = none
dotnet_diagnostic.ZA0208.severity = warning
dotnet_diagnostic.ZA0209.severity = warning
dotnet_diagnostic.ZA0210.severity = warning
dotnet_diagnostic.ZA0211.severity = warning
dotnet_diagnostic.ZA0212.severity = warning
dotnet_diagnostic.ZA0213.severity = warning

# Plain comments.
dotnet_diagnostic.ZA0214.severity = warning
dotnet_diagnostic.ZA0215.severity = warning
dotnet_diagnostic.ZA0216.severity = warning

# Disables expression body suggestions that conflict with the configured Stanza body rules.
dotnet_diagnostic.IDE0021.severity = none
dotnet_diagnostic.IDE0022.severity = none
dotnet_diagnostic.IDE0023.severity = none
dotnet_diagnostic.IDE0024.severity = none
dotnet_diagnostic.IDE0061.severity = none

# Disabled so a named tuple stays one variable instead of being deconstructed into separate variables.
dotnet_diagnostic.IDE0042.severity = none

# Disabled so a fix does not discard an unused expression value with `_ = ...`.
dotnet_diagnostic.IDE0058.severity = none

# Disabled so a fix does not remove an assignment whose value is never read.
dotnet_diagnostic.IDE0059.severity = none

# `csharp_style_prefer_primary_constructors` states the preference,
# and this rule stays off so the style pass of format.ps1 does not convert an explicit constructor.
dotnet_diagnostic.IDE0290.severity = none

# The build reports IDE0005 only because Directory.Build.props sets GenerateDocumentationFile.
dotnet_diagnostic.IDE0005.severity = warning

# An unused private member or parameter fails the build, as CONVENTIONS.md C2 asks.
dotnet_diagnostic.IDE0051.severity = warning
dotnet_diagnostic.IDE0052.severity = warning
dotnet_diagnostic.IDE0060.severity = warning

# The naming rules below report as IDE1006.
dotnet_diagnostic.IDE1006.severity = warning

# Disabled so a fix does not hoist a constant array argument into a new static field.
dotnet_diagnostic.CA1861.severity = none

# Disabled so a fix does not hoist a `SearchValues` instance into a new static field.
dotnet_diagnostic.CA1870.severity = none

# A build with AnalysisMode=Recommended found no CA hit in the sources, so these pins keep it that way instead of turning the whole mode on.
# Each rule guards something this code can get wrong: a culture-sensitive string call, an ignored result, a wrong exception, a missed cancellation token,
# a broken equality or disposal contract, a weak hash, or a LINQ, string or dictionary call that costs more than its replacement.
# Naming and API-design rules are left out because CONVENTIONS.md and the naming rules below own names and nothing here ships a library API.
dotnet_diagnostic.CA1001.severity = warning
dotnet_diagnostic.CA1067.severity = warning
dotnet_diagnostic.CA1068.severity = warning
dotnet_diagnostic.CA1069.severity = warning
dotnet_diagnostic.CA1304.severity = warning
dotnet_diagnostic.CA1305.severity = warning
dotnet_diagnostic.CA1309.severity = warning
dotnet_diagnostic.CA1310.severity = warning
dotnet_diagnostic.CA1311.severity = warning
dotnet_diagnostic.CA1507.severity = warning
dotnet_diagnostic.CA1515.severity = warning
dotnet_diagnostic.CA1806.severity = warning
dotnet_diagnostic.CA1816.severity = warning
dotnet_diagnostic.CA1822.severity = warning
dotnet_diagnostic.CA1825.severity = warning
dotnet_diagnostic.CA1826.severity = warning
dotnet_diagnostic.CA1827.severity = warning
dotnet_diagnostic.CA1829.severity = warning
dotnet_diagnostic.CA1834.severity = warning
dotnet_diagnostic.CA1835.severity = warning
dotnet_diagnostic.CA1836.severity = warning
dotnet_diagnostic.CA1841.severity = warning
dotnet_diagnostic.CA1845.severity = warning
dotnet_diagnostic.CA1846.severity = warning
dotnet_diagnostic.CA1847.severity = warning
dotnet_diagnostic.CA1851.severity = warning
dotnet_diagnostic.CA1853.severity = warning
dotnet_diagnostic.CA1854.severity = warning
dotnet_diagnostic.CA1858.severity = warning
dotnet_diagnostic.CA1859.severity = warning
dotnet_diagnostic.CA1860.severity = warning
dotnet_diagnostic.CA1862.severity = warning
dotnet_diagnostic.CA1864.severity = warning
dotnet_diagnostic.CA1865.severity = warning
dotnet_diagnostic.CA1866.severity = warning
dotnet_diagnostic.CA1868.severity = warning
dotnet_diagnostic.CA1872.severity = warning
dotnet_diagnostic.CA1874.severity = warning
dotnet_diagnostic.CA1875.severity = warning
dotnet_diagnostic.CA2009.severity = warning
dotnet_diagnostic.CA2011.severity = warning
dotnet_diagnostic.CA2016.severity = warning
dotnet_diagnostic.CA2201.severity = warning
dotnet_diagnostic.CA2208.severity = warning
dotnet_diagnostic.CA2214.severity = warning
dotnet_diagnostic.CA2215.severity = warning
dotnet_diagnostic.CA2241.severity = warning
dotnet_diagnostic.CA2244.severity = warning
dotnet_diagnostic.CA2245.severity = warning
dotnet_diagnostic.CA2249.severity = warning
dotnet_diagnostic.CA2250.severity = warning
dotnet_diagnostic.CA2251.severity = warning
dotnet_diagnostic.CA2263.severity = warning
dotnet_diagnostic.CA5350.severity = warning
dotnet_diagnostic.CA5351.severity = warning

# Disabled so a fix does not add `[ResourceLock]` to a test class or method.
dotnet_diagnostic.MSTEST0074.severity = none
dotnet_diagnostic.MSTEST0075.severity = none

# Disabled so a fix does not rewrite an assertion on a comparison into another `Assert` method.
dotnet_diagnostic.MSTEST0037.severity = none

# Disabled so a fix does not pass `TestContext.CancellationToken` to an async overload that accepts a token.
dotnet_diagnostic.MSTEST0049.severity = none

# Disabled so a fix does not change how a test times out.
dotnet_diagnostic.MSTEST0045.severity = none

# Disabled so a fix does not turn an inconclusive result or an early return into a condition attribute that skips the test.
dotnet_diagnostic.MSTEST0061.severity = none
dotnet_diagnostic.MSTEST0079.severity = none
dotnet_diagnostic.MSTEST0080.severity = none
dotnet_diagnostic.MSTEST0083.severity = none

# Disabled because the fix also enables unsafe code, a change to the project's compilation options.
dotnet_diagnostic.SYSLIB1054.severity = none

# Keep this equal to the root `printWidth` in `.csharpierrc.json`.
stanza_max_line_length = 150

stanza_doc_max_line_length = 120
stanza_doc_min_tail_words = 3

stanza_multiline_body_trigger = body

# Indentation and line endings.
indent_size = 4
indent_style = tab
tab_width = 4
end_of_line = crlf
insert_final_newline = true

# Editor behavior.
dotnet_hide_advanced_members = false
dotnet_member_insertion_location = with_other_members_of_the_same_kind
dotnet_property_generation_behavior = prefer_throwing_properties
dotnet_search_reference_assemblies = true

# Imports and the file header.
dotnet_separate_import_directive_groups = false
dotnet_sort_system_directives_first = true
file_header_template = unset
csharp_using_directive_placement = outside_namespace:warning

# Qualification with this.
dotnet_style_qualification_for_event = false:warning
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_qualification_for_property = false:warning

# Predefined types.
dotnet_style_predefined_type_for_locals_parameters_members = true:warning
dotnet_style_predefined_type_for_member_access = true:warning

# Parentheses.
dotnet_style_parentheses_in_arithmetic_binary_operators = always_for_clarity:warning
dotnet_style_parentheses_in_other_binary_operators = always_for_clarity:warning
dotnet_style_parentheses_in_other_operators = never_if_unnecessary:warning
dotnet_style_parentheses_in_relational_binary_operators = always_for_clarity:warning

# Modifiers.
dotnet_style_require_accessibility_modifiers = for_non_interface_members
csharp_preferred_modifier_order = public,private,protected,internal,file,static,extern,new,virtual,abstract,sealed,override,readonly,unsafe,required,volatile,async

# Expression preferences.
dotnet_prefer_system_hash_code = true:warning
dotnet_style_coalesce_expression = true:warning
dotnet_style_collection_initializer = true:warning
dotnet_style_explicit_tuple_names = true:warning
dotnet_style_namespace_match_folder = true
dotnet_style_null_propagation = true:warning
dotnet_style_object_initializer = true:warning
dotnet_style_operator_placement_when_wrapping = beginning_of_line
dotnet_style_prefer_auto_properties = true:warning
dotnet_style_prefer_collection_expression = when_types_loosely_match
dotnet_style_prefer_compound_assignment = true:warning

# An if/else that assigns or returns stays a statement instead of becoming a conditional expression.
dotnet_style_prefer_conditional_expression_over_assignment = false
dotnet_style_prefer_conditional_expression_over_return = false

dotnet_style_prefer_foreach_explicit_cast_in_source = when_strongly_typed
dotnet_style_prefer_inferred_anonymous_type_member_names = true
dotnet_style_prefer_inferred_tuple_names = true:warning
dotnet_style_prefer_is_null_check_over_reference_equality_method = true:warning
dotnet_style_prefer_non_hidden_explicit_cast_in_source = true
dotnet_style_prefer_simplified_boolean_expressions = true:warning
dotnet_style_prefer_simplified_interpolation = true

# Fields and unused code.
dotnet_style_readonly_field = true:warning
dotnet_code_quality_unused_parameters = all:warning
dotnet_remove_unnecessary_suppression_exclusions = none

# Blank lines in code.
dotnet_style_allow_multiple_blank_lines_experimental = false:warning
dotnet_style_allow_statement_immediately_after_block_experimental = false:warning
csharp_style_allow_blank_line_after_colon_in_constructor_initializer_experimental = false:warning
csharp_style_allow_blank_line_after_token_in_arrow_expression_clause_experimental = true:silent
csharp_style_allow_blank_line_after_token_in_conditional_expression_experimental = false:warning
csharp_style_allow_blank_lines_between_consecutive_braces_experimental = false:warning
csharp_style_allow_embedded_statements_on_same_line_experimental = false:warning

# The var keyword.
csharp_style_var_elsewhere = false:warning
csharp_style_var_for_built_in_types = false:warning
csharp_style_var_when_type_is_apparent = true:warning

# Expression bodies.
csharp_style_expression_bodied_accessors = when_on_single_line:warning
csharp_style_expression_bodied_constructors = when_on_single_line
csharp_style_expression_bodied_indexers = when_on_single_line:warning
csharp_style_expression_bodied_lambdas = when_on_single_line:warning
csharp_style_expression_bodied_local_functions = when_on_single_line
csharp_style_expression_bodied_methods = when_on_single_line
csharp_style_expression_bodied_operators = when_on_single_line
csharp_style_expression_bodied_properties = when_on_single_line:warning

# Pattern matching and null checks.
csharp_style_pattern_matching_over_as_with_null_check = true:warning
csharp_style_pattern_matching_over_is_with_cast_check = true:warning
csharp_style_prefer_extended_property_pattern = true
csharp_style_prefer_not_pattern = true:warning
csharp_style_prefer_pattern_matching = true:warning
csharp_style_prefer_switch_expression = true
csharp_style_conditional_delegate_call = true:warning

# Static and readonly.
csharp_prefer_static_anonymous_function = true:warning
csharp_prefer_static_local_function = true:warning
csharp_style_prefer_readonly_struct = true:warning
csharp_style_prefer_readonly_struct_member = true

# Declarations and statements.
csharp_prefer_braces = when_multiline:warning
csharp_prefer_simple_using_statement = true:warning
csharp_prefer_system_threading_lock = true
csharp_style_namespace_declarations = file_scoped:warning
csharp_style_prefer_labeled_jump_statements = true
csharp_style_prefer_method_group_conversion = true:warning
csharp_style_prefer_primary_constructors = true
csharp_style_prefer_simple_property_accessors = true
csharp_style_prefer_top_level_statements = true:suggestion

# Expressions and types.
csharp_prefer_simple_default_expression = true:warning
csharp_style_deconstructed_variable_declaration = true
csharp_style_implicit_object_creation_when_type_is_apparent = true:warning
csharp_style_inlined_variable_declaration = true:warning
csharp_style_prefer_implicitly_typed_lambda_expression = true
csharp_style_prefer_index_operator = true:warning
csharp_style_prefer_local_over_anonymous_function = true:warning
csharp_style_prefer_null_check_over_type_check = true:warning
csharp_style_prefer_range_operator = true:warning
csharp_style_prefer_tuple_swap = true:warning
csharp_style_prefer_unbound_generic_type_in_nameof = true
csharp_style_prefer_utf8_string_literals = true
csharp_style_throw_expression = true:warning

# The discard form that IDE0058 and IDE0059 would write; both are disabled above.
csharp_style_unused_value_assignment_preference = discard_variable
csharp_style_unused_value_expression_statement_preference = discard_variable

# Braces and new lines.
csharp_new_line_before_catch = true
csharp_new_line_before_else = true
csharp_new_line_before_finally = true
csharp_new_line_before_members_in_anonymous_types = true
csharp_new_line_before_members_in_object_initializers = true
csharp_new_line_before_open_brace = all
csharp_new_line_between_query_expression_clauses = true

# Indentation of blocks and labels.
csharp_indent_block_contents = true
csharp_indent_braces = false
csharp_indent_case_contents = true
csharp_indent_case_contents_when_block = true
csharp_indent_labels = one_less_than_current
csharp_indent_switch_labels = true

# Spacing.
csharp_space_after_cast = false
csharp_space_after_colon_in_inheritance_clause = true
csharp_space_after_comma = true
csharp_space_after_dot = false
csharp_space_after_keywords_in_control_flow_statements = true
csharp_space_after_semicolon_in_for_statement = true
csharp_space_around_binary_operators = before_and_after
csharp_space_around_declaration_statements = false
csharp_space_before_colon_in_inheritance_clause = true
csharp_space_before_comma = false
csharp_space_before_dot = false
csharp_space_before_open_square_brackets = false
csharp_space_before_semicolon_in_for_statement = false
csharp_space_between_empty_square_brackets = false
csharp_space_between_method_call_empty_parameter_list_parentheses = false
csharp_space_between_method_call_name_and_opening_parenthesis = false
csharp_space_between_method_call_parameter_list_parentheses = false
csharp_space_between_method_declaration_empty_parameter_list_parentheses = false
csharp_space_between_method_declaration_name_and_open_parenthesis = false
csharp_space_between_method_declaration_parameter_list_parentheses = false
csharp_space_between_parentheses = false
csharp_space_between_square_brackets = false

# Single-line blocks and statements.
csharp_preserve_single_line_blocks = true
csharp_preserve_single_line_statements = true

# The naming rules below follow the .NET identifier guidance and the dotnet/runtime coding style:
#   https://learn.microsoft.com/dotnet/csharp/fundamentals/coding-style/identifier-names
#   https://github.com/dotnet/runtime/blob/main/docs/coding-guidelines/coding-style.md

dotnet_naming_rule.interface_should_be_begins_with_i.severity = warning
dotnet_naming_rule.interface_should_be_begins_with_i.symbols = interface
dotnet_naming_rule.interface_should_be_begins_with_i.style = begins_with_i

dotnet_naming_rule.types_should_be_pascal_case.severity = warning
dotnet_naming_rule.types_should_be_pascal_case.symbols = types
dotnet_naming_rule.types_should_be_pascal_case.style = pascal_case

dotnet_naming_rule.namespaces_should_be_pascal_case.severity = warning
dotnet_naming_rule.namespaces_should_be_pascal_case.symbols = namespaces
dotnet_naming_rule.namespaces_should_be_pascal_case.style = pascal_case

dotnet_naming_rule.non_field_members_should_be_pascal_case.severity = warning
dotnet_naming_rule.non_field_members_should_be_pascal_case.symbols = non_field_members
dotnet_naming_rule.non_field_members_should_be_pascal_case.style = pascal_case

# Type parameters use `T` + PascalCase; bare `T` is valid.
dotnet_naming_rule.type_parameters_should_be_t_prefixed_pascal_case.severity = warning
dotnet_naming_rule.type_parameters_should_be_t_prefixed_pascal_case.symbols = type_parameters
dotnet_naming_rule.type_parameters_should_be_t_prefixed_pascal_case.style = t_prefixed_pascal_case

dotnet_naming_rule.visible_and_const_fields_should_be_pascal_case.severity = warning
dotnet_naming_rule.visible_and_const_fields_should_be_pascal_case.symbols = visible_fields
dotnet_naming_rule.visible_and_const_fields_should_be_pascal_case.style = pascal_case

# Private and internal instance fields use `_` + camelCase.
dotnet_naming_rule.private_fields_should_be_underscored_camel_case.severity = warning
dotnet_naming_rule.private_fields_should_be_underscored_camel_case.symbols = private_internal_fields
dotnet_naming_rule.private_fields_should_be_underscored_camel_case.style = underscored_camel_case

dotnet_naming_rule.private_static_fields_should_be_s_prefixed_camel_case.severity = warning
dotnet_naming_rule.private_static_fields_should_be_s_prefixed_camel_case.symbols = private_internal_static_fields
dotnet_naming_rule.private_static_fields_should_be_s_prefixed_camel_case.style = s_prefixed_camel_case

# Constants use PascalCase despite the static-field rule.
dotnet_naming_rule.private_const_fields_should_be_pascal_case.severity = warning
dotnet_naming_rule.private_const_fields_should_be_pascal_case.symbols = private_internal_const_fields
dotnet_naming_rule.private_const_fields_should_be_pascal_case.style = pascal_case

dotnet_naming_rule.locals_should_be_camel_case.severity = warning
dotnet_naming_rule.locals_should_be_camel_case.symbols = locals
dotnet_naming_rule.locals_should_be_camel_case.style = camel_case

# Parameters use camelCase; a positional record parameter becomes a public property, so it may need a local naming suppression.
dotnet_naming_rule.parameters_should_be_camel_case.severity = warning
dotnet_naming_rule.parameters_should_be_camel_case.symbols = parameters
dotnet_naming_rule.parameters_should_be_camel_case.style = camel_case

# Naming symbol groups.
dotnet_naming_symbols.interface.applicable_kinds = interface
dotnet_naming_symbols.interface.applicable_accessibilities = *
dotnet_naming_symbols.interface.required_modifiers =

dotnet_naming_symbols.types.applicable_kinds = class, struct, enum, delegate
dotnet_naming_symbols.types.applicable_accessibilities = *
dotnet_naming_symbols.types.required_modifiers =

dotnet_naming_symbols.namespaces.applicable_kinds = namespace
dotnet_naming_symbols.namespaces.applicable_accessibilities = *
dotnet_naming_symbols.namespaces.required_modifiers =

dotnet_naming_symbols.non_field_members.applicable_kinds = property, event, method, local_function
dotnet_naming_symbols.non_field_members.applicable_accessibilities = *
dotnet_naming_symbols.non_field_members.required_modifiers =

dotnet_naming_symbols.type_parameters.applicable_kinds = type_parameter
dotnet_naming_symbols.type_parameters.applicable_accessibilities = *
dotnet_naming_symbols.type_parameters.required_modifiers =

# Matches fields outside the private and internal groups.
dotnet_naming_symbols.visible_fields.applicable_kinds = field
dotnet_naming_symbols.visible_fields.applicable_accessibilities = public, protected, protected_internal, private_protected
dotnet_naming_symbols.visible_fields.required_modifiers =

dotnet_naming_symbols.private_internal_fields.applicable_kinds = field
dotnet_naming_symbols.private_internal_fields.applicable_accessibilities = private, internal
dotnet_naming_symbols.private_internal_fields.required_modifiers =

dotnet_naming_symbols.private_internal_static_fields.applicable_kinds = field
dotnet_naming_symbols.private_internal_static_fields.applicable_accessibilities = private, internal
dotnet_naming_symbols.private_internal_static_fields.required_modifiers = static

dotnet_naming_symbols.private_internal_const_fields.applicable_kinds = field
dotnet_naming_symbols.private_internal_const_fields.applicable_accessibilities = private, internal
dotnet_naming_symbols.private_internal_const_fields.required_modifiers = const

dotnet_naming_symbols.locals.applicable_kinds = local
dotnet_naming_symbols.locals.applicable_accessibilities = local
dotnet_naming_symbols.locals.required_modifiers =

dotnet_naming_symbols.parameters.applicable_kinds = parameter
dotnet_naming_symbols.parameters.applicable_accessibilities = *
dotnet_naming_symbols.parameters.required_modifiers =

# Naming styles.
dotnet_naming_style.pascal_case.capitalization = pascal_case
dotnet_naming_style.pascal_case.required_prefix =
dotnet_naming_style.pascal_case.required_suffix =
dotnet_naming_style.pascal_case.word_separator =

dotnet_naming_style.begins_with_i.capitalization = pascal_case
dotnet_naming_style.begins_with_i.required_prefix = I
dotnet_naming_style.begins_with_i.required_suffix =
dotnet_naming_style.begins_with_i.word_separator =

dotnet_naming_style.t_prefixed_pascal_case.capitalization = pascal_case
dotnet_naming_style.t_prefixed_pascal_case.required_prefix = T
dotnet_naming_style.t_prefixed_pascal_case.required_suffix =
dotnet_naming_style.t_prefixed_pascal_case.word_separator =

dotnet_naming_style.camel_case.capitalization = camel_case
dotnet_naming_style.camel_case.required_prefix =
dotnet_naming_style.camel_case.required_suffix =
dotnet_naming_style.camel_case.word_separator =

dotnet_naming_style.underscored_camel_case.capitalization = camel_case
dotnet_naming_style.underscored_camel_case.required_prefix = _
dotnet_naming_style.underscored_camel_case.required_suffix =
dotnet_naming_style.underscored_camel_case.word_separator =

dotnet_naming_style.s_prefixed_camel_case.capitalization = camel_case
dotnet_naming_style.s_prefixed_camel_case.required_prefix = s_
dotnet_naming_style.s_prefixed_camel_case.required_suffix =
dotnet_naming_style.s_prefixed_camel_case.word_separator =

# Keeps the test width aligned with CSharpier's narrower test override.
[tests/**/*.cs]
stanza_max_line_length = 100
stanza_doc_max_line_length = 100

# A raw string in a test is the input the test reads, so the markup-literal rules would change what it checks.
dotnet_diagnostic.ZA0101.severity = none
dotnet_diagnostic.ZA0103.severity = none
dotnet_diagnostic.ZA0104.severity = none
dotnet_diagnostic.ZA0105.severity = none

# MSTest finds a test class only when it is public.
dotnet_diagnostic.CA1515.severity = none

# The compiler finds IsExternalInit only by its namespace, so IDE0130 must not change the namespace to match the directory.
[IsExternalInit.cs]
dotnet_diagnostic.IDE0130.severity = none

# The directory walk already skips bin and obj; this section also keeps an explicit path into them out of the run.
[**/{bin,obj}/**]
stanza_markup_enabled = false

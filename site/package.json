{
	"name": "stanza-configurator",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"description": "The rule configurator of the Stanza analyzers, built from the pages under docs/.",
	"engines": {
		"node": "^22.12.0 || ^24.0.0 || >=26.0.0"
	},
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit",

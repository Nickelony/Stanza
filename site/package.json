		"lint": "oxlint .",
		"test": "vitest run"
	},
	"devDependencies": {
		"@types/node": "^24.19.2",
		"oxlint": "^1.90.0",
		"prettier": "^3.9.10",
		"shiki": "^4.5.0",
		"typescript": "^7.0.2",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	}
